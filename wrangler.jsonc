{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turbobard-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
